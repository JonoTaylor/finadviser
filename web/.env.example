# Development Neon Postgres connection; enter the real value in environment settings.
DATABASE_URL=

# Optional Vercel AI Gateway key for web chat and AI analysis.
AI_GATEWAY_API_KEY=

# Optional deploy-time model override, e.g. provider/model.
MODEL_ID=

# Optional fast background categorisation model; independent of the adviser.
# Default: openai/gpt-4.1-mini. Public merchant research uses the same Gateway key.
CATEGORIZATION_MODEL_ID=

# Optional independent model for the native public merchant search router.
MERCHANT_RESEARCH_MODEL_ID=
# Set false to disable new external merchant lookups (local categorisation continues).
MERCHANT_RESEARCH_ENABLED=true

# Required for production authentication. Use independent, strong values.
APP_PASSWORD=
SESSION_SECRET=
